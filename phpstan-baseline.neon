# Larastan (level 7) の既存エラーを凍結するベースライン（監査 C-5）。
#
# 生成時点（2026-11-23）で 382 件。大半は nullsafe.neverNull /
# missingType.iterableValue / Money ドメインの enum と string の型不一致で、
# 挙動のバグではなく型情報の不足である。
#
# ベースラインにより「新しく増えた分だけ CI が落ちる」状態にする。
# 既存分は別 PR で段階的に減らす（docs/audit/remediation-roadmap.md Phase 6）。
#
# 生成・更新は次のコマンドで行う。手で編集しないこと。
#
#     vendor/bin/phpstan analyse --generate-baseline
#
parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: app/Console/Commands/ReconcileAiUsageCommand.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: app/Domain/Kioku/Audio/AudioDurationProbe.php

		-
			message: '#^Parameter \#2 \$length of function fread expects int\<1, max\>, int\<0, 16\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Domain/Kioku/Audio/AudioDurationProbe.php

		-
			message: '#^Right side of && is always true\.$#'
