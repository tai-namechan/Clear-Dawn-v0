		-
			message: '#^Property App\\Domain\\Kioku\\Models\\KiokuConciergeSchedule\:\:\$next_delivery_at \(Illuminate\\Support\\Carbon\|null\) does not accept Carbon\\CarbonImmutable\.$#'
